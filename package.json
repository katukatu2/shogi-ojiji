{
  "name": "shogi-ojiji",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build && node scripts/prepare-offline.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "engine:copy": "node scripts/copy-engine.mjs",
    "cap:sync": "npm run build && npx cap sync",
    "cap:android": "npm run build && npx cap sync android && npx cap open android",
    "cap:ios": "npm run build && npx cap sync ios && npx cap open ios",
    "selfplay": "vite-node scripts/selfplay.ts --",
    "assets:faces": "python scripts/build-faces.py",
    "assets:sfx": "node scripts/encode-sfx.mjs",
    "assets:body": "python scripts/build-body.py",
    "e2e": "playwright test",
    "e2e:pwa": "playwright test --config playwright.pwa.config.ts",
    "release:check": "node scripts/check-release.mjs",
    "store:shots": "node scripts/store-screenshots.mjs",
    "icons": "node scripts/build-icons.mjs"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/ios": "8.5.1",
    "@playwright/test": "^1.63.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.4.1",
    "lamejs": "^1.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@mizarjp/yaneuraou.k-p": "^7.6.3-alpha.0"
  },
  "license": "GPL-3.0"
}
